{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/types/*": ["./types/*"],
      "@/core/*": ["./src/core/*"],
      "@/config/*": ["./src/config/*"],
      "@/database/*": ["./src/database/*"],
      "@/commands/*": ["./src/commands/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/cache/*": ["./src/cache/*"]
    }
  },
  "include": ["src/**/*", "types/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.js",
    "**/*.spec.js",
    "**/*.config.js"
  ],
  "typeAcquisition": {
    "enable": true,
    "include": ["node_modules/@types"]
  }
}
