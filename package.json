{
  "name": "sonic-bot",
  "version": "3.0.0",
  "description": "Sonic is a self-hosted WhatsApp community bot for group management, member engagement and admin automation with economy, mini-games, and modular command tools.",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config=jest.config.cjs --runInBand --coverage=false --forceExit",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config=jest.config.cjs --runInBand",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit -p jsconfig.json",
    "lint": "npx eslint ."
  },
  "keywords": [
    "sonic",
    "xodobyte",
    "baileys",
    "whatsapp",
    "group management",
    "member engagement",
    "admin automation"
  ],
  "author": "xodobyte",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@cacheable/node-cache": "^3.1.1",
    "baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13.0.2",
    "pino": "^10.3.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
